<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false'
      b:defaultwidgetversion='2'
      b:layoutsVersion='3'
      b:responsive='true'
      expr:dir='data:blog.languageDirection'
      expr:lang='data:blog.locale'
      xmlns='http://www.w3.org/1999/xhtml'
      xmlns:b='http://www.google.com/2005/gml/b'
      xmlns:data='http://www.google.com/2005/gml/data'
      xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta content='width=device-width,initial-scale=1,viewport-fit=cover' name='viewport'/>
  <meta content='#121416' name='theme-color'/>
  <meta content='dark' name='color-scheme'/>
  <!-- Public fallback. Blogger custom Favicon, when configured, is emitted later by all-head-content. -->
  <link href='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/assets/brand/favicon-fallback.png' rel='icon' type='image/png'/>
  <b:include data='blog' name='all-head-content'/>
  <title><data:blog.pageTitle/></title>

  <!-- Search identity. Blogger remains authoritative for index/noindex and canonical/platform head data. -->
  <b:if cond='data:view.isHomepage'>
    <meta content='Seguir el origen, los límites y el ejercicio del poder. Conceptos, normas, documentos y análisis organizados para situar, relacionar y verificar cada afirmación.' name='description'/>
    <meta content='max-image-preview:large,max-snippet:-1,max-video-preview:-1' name='robots'/>
  </b:if>
  <b:if cond='data:view.isSingleItem'>
    <meta content='max-image-preview:large,max-snippet:-1,max-video-preview:-1' name='robots'/>
  </b:if>

  <!-- Open Graph + X Card. Server-rendered so social crawlers do not depend on JavaScript. -->
  <meta expr:content='data:blog.pageTitle' property='og:title'/>
  <meta expr:content='data:blog.canonicalUrl' property='og:url'/>
  <meta content='La hoja de ruta' property='og:site_name'/>
  <meta content='es' property='og:locale'/>
  <b:if cond='data:view.isSingleItem'>
    <meta content='article' property='og:type'/>
  <b:else/>
    <meta content='website' property='og:type'/>
  </b:if>
  <b:if cond='data:blog.metaDescription'>
    <meta expr:content='data:blog.metaDescription' property='og:description'/>
    <meta expr:content='data:blog.metaDescription' name='twitter:description'/>
  <b:else/>
    <meta content='Seguir el origen, los límites y el ejercicio del poder. Conceptos, normas, documentos y análisis organizados para situar, relacionar y verificar cada afirmación.' property='og:description'/>
    <meta content='Seguir el origen, los límites y el ejercicio del poder. Conceptos, normas, documentos y análisis organizados para situar, relacionar y verificar cada afirmación.' name='twitter:description'/>
  </b:if>
  <meta content='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/assets/social/zenblog-social-card.png' property='og:image'/>
  <meta content='image/png' property='og:image:type'/>
  <meta content='600' property='og:image:width'/>
  <meta content='315' property='og:image:height'/>
  <meta content='Tarjeta editorial de La hoja de ruta' property='og:image:alt'/>
  <meta content='summary_large_image' name='twitter:card'/>
  <meta content='@la_RsisTncia' name='twitter:site'/>
  <meta expr:content='data:blog.pageTitle' name='twitter:title'/>
  <meta content='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/assets/social/zenblog-social-card.png' name='twitter:image'/>
  <meta content='Tarjeta editorial de La hoja de ruta' name='twitter:image:alt'/>

  <b:if cond='data:view.isHomepage'>
    <script type='application/ld+json'>{"@context":"https://schema.org","@type":"WebSite","name":"La hoja de ruta","url":"https://cubalahojaderuta.blogspot.com/","description":"Seguir el origen, los límites y el ejercicio del poder. Conceptos, normas, documentos y análisis organizados para situar, relacionar y verificar cada afirmación.","inLanguage":"es"}</script>
  </b:if>

  <!-- Connection hints and parallel styles: no render-blocking CSS @import chain in the active theme. -->
  <link href='https://fonts.googleapis.com' rel='preconnect'/>
  <link crossorigin='anonymous' href='https://fonts.gstatic.com' rel='preconnect'/>
  <link href='https://cdn.jsdelivr.net' rel='preconnect'/>
  <link href='https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&amp;family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&amp;display=swap' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/src/ui/styles/tokens.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/src/ui/styles/shell.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/src/features/home/home.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/src/features/explore/explore.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/src/features/article/article.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/src/ui/styles/responsive.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/dist/zenblog.js' rel='modulepreload'/>
  <link href='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/src/bootstrap/createZenBlog.js' rel='modulepreload'/>

  <b:skin><![CDATA[
    /* Blogger is the composition root only. Product UI lives in GitHub modules. */
    html,body{margin:0;padding:0}
  ]]></b:skin>
</head>
<body>
  <b:class cond='data:view.isHomepage' name='homepage-view'/>
  <b:class cond='data:view.isSingleItem' name='item-view'/>

  <div id='zen-blog-prototype'>
    <header class='zen-site-header'>
      <a aria-label='Ir a la portada' class='zen-brand' data-zen-route='zen-home' href='#zen-home'>
        <span aria-hidden='true' class='zen-brand-mark'>HR</span>
        <span class='zen-brand-copy'>
          <strong>La hoja de ruta</strong>
          <small>Soberanía · Constitución · Estado</small>
        </span>
      </a>

      <nav aria-label='Navegación principal de La hoja de ruta' class='zen-primary-nav'>
        <a data-zen-route='zen-home' href='#zen-home'>Portada</a>
        <a data-zen-route='zen-explore' href='#zen-explore'>Explorar</a>
        <a class='zen-player-nav' href='#zen-radio-player'>Reproductor</a>
        <a data-zen-route='zen-about' href='#zen-about'>Acerca de</a>
      </nav>
    </header>

    <main id='zen-app'>
      <section aria-hidden='false' class='zen-view' data-zen-view='home' id='zen-home'>
        <b:section class='zen-blogger-content' id='page_body' maxwidgets='1' showaddelement='false'>
          <b:widget id='Blog1' locked='true' title='Entradas del blog' type='Blog' visible='true' version='2'/>
        </b:section>
      </section>

      <section aria-hidden='true' class='zen-view' data-zen-view='explore' hidden='hidden' id='zen-explore'/>

      <section aria-hidden='true' class='zen-view' data-zen-view='about' hidden='hidden' id='zen-about'>
        <div class='zen-reading'>
          <h1>La hoja de ruta</h1>
          <p>Plataforma editorial y documental para organizar, leer y recuperar conocimiento sobre soberanía, Constitución y Estado.</p>
        </div>
      </section>
    </main>
  </div>

  <!-- Public product entry. -->
  <script src='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/dist/zenblog.js' type='module'></script>
  <!-- Auxiliary modules (Admin/About/Inspector) load only when needed. -->
  <script src='https://cdn.jsdelivr.net/gh/devMod3/cuba-la-hoja-de-ruta@3aa43f5b347a0711dafb4073fb5f2213a88909cc/tools/runtime/bootstrap.js' type='module'></script>

  <!-- Protected independent foreground player. -->
  <script src='https://devmod3.github.io/zen-radio-player/assets/zen-radio-player.js?v=1.0.3' type='module'></script>
</body>
</html>