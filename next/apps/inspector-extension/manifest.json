{
  "manifest_version": 3,
  "name": "Zen Inspector",
  "description": "Inspector DOM local y privado para Brave y navegadores Chromium.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Activar Zen Inspector"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
