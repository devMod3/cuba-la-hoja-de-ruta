{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve"
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts",
